{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "pnpm --filter central build",
		"watchPatterns": ["apps/central/**", "packages/**", "pnpm-lock.yaml"]
	},
	"deploy": {
		"startCommand": "pnpm --filter central start",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	},
	"environments": {
		"staging": {
			"build": {
				"watchPatterns": ["deploy/staging-release.txt"]
			}
		}
	}
}
