{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "pnpm --filter hr build",
		"watchPatterns": ["apps/hr/**", "packages/**", "pnpm-lock.yaml"]
	},
	"deploy": {
		"startCommand": "pnpm --filter hr start",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	},
	"environments": {
		"staging": {
			"build": {
				"watchPatterns": ["deploy/staging-release.txt"]
			}
		}
	}
}
