{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "NIXPACKS",
		"buildCommand": "pnpm --filter hr build",
		"watchPatterns": ["apps/hr/**", "packages/**", "pnpm-lock.yaml"]
	},
	"deploy": {
		"startCommand": "pnpm --filter hr start",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	}
}
