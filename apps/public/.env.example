# Cloudflare Turnstile — public site key for the intake forms
VITE_CLOUDFLARE_TURNSTILE_SITEKEY=

# Server-side only (used by TanStack Start server functions).
#
# Railway backend API origin. This app never talks to it from the browser: reads come from
# the shape proxy during SSR and form submissions are forwarded from the server, so the API
# origin stays out of the site's CSP and the Turnstile secret stays in the API.
API_URL=http://localhost:3005
