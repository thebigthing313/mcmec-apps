# Cloudflare Turnstile — public site key for the intake forms
VITE_CLOUDFLARE_TURNSTILE_SITEKEY=

# Server-side only (used by TanStack Start server functions).
#
# Railway backend API origin. This app never calls it from the browser: reads happen during
# SSR and form submissions are forwarded from the server, so the API origin stays out of the
# site's CSP. Plain http on purpose — this is Node calling localhost, and https would mean
# teaching Node to trust Caddy's local CA for nothing.
#
# Browse the site at https://localhost:3448 (Caddy) so HMR and the dev origin match.
API_URL=http://localhost:3543

# Brand images (logos, favicons, hero photographs), served by the api at /assets.
#
# Optional. Unset, they come from production — the bytes are identical everywhere, so one
# shared browser cache is the right default. Set this to your own api when a branch ADDS an
# image: it does not exist on production until that branch reaches `main`, so a new hero or
# logo 404s until then.
VITE_ASSETS_ORIGIN=https://localhost:3443
