{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@mcmec/lib/*": ["../../packages/lib/src/*"],
			"@mcmec/schemas/*": ["../../packages/schemas/src/*"],
			"@mcmec/ui/*": ["../../packages/ui/src/*"]
		},
		// "node" is needed by `server/` — those modules read `process.env` and never ship to the
		// browser.
		"types": ["vite/client", "node"]
	},
	"exclude": ["node_modules"],
	"extends": "@mcmec/typescript-config/tanstack-start.json",
	"include": ["**/*.ts", "**/*.tsx", "src/env.d.ts"]
}
