# Postgres — least-privilege app role (NOT the postgres superuser). See src/db/triggers.sql.
DATABASE_URL=postgresql://app_rw:CHANGE_ME@postgres.railway.internal:5432/railway

# Postgres — table owner, used ONLY by `db:migrate`, which runs before the server starts on
# each deploy. app_rw has no DDL rights on purpose, so migrations need their own connection.
# Set this on the Railway service; without it a deploy carrying a new migration will fail.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres.railway.internal:5432/railway

# Better Auth
BETTER_AUTH_URL=https://api.middlesexmosquito.org
BETTER_AUTH_SECRET=CHANGE_ME
COOKIE_DOMAIN=.middlesexmosquito.org

# Namespaces the session cookie. REQUIRED on staging, because staging hosts are siblings of
# production under the same parent domain (hr-staging.middlesexmosquito.org beside
# hr.middlesexmosquito.org) and COOKIE_DOMAIN scopes the cookie to that shared parent. Without
# a distinct prefix, both environments write the SAME cookie name at the SAME scope: signing
# into staging clobbers a production session and vice versa, and each API then receives the
# other environment's token and rejects it — which looks like random logouts, not an error.
#   production -> mcmec        staging -> mcmec-staging
# Unset falls back to Better Auth's "better-auth" default, which is right for local dev.
COOKIE_PREFIX=mcmec
TRUSTED_ORIGINS=https://central.middlesexmosquito.org,https://website.middlesexmosquito.org,https://admin.middlesexmosquito.org,https://hr.middlesexmosquito.org,https://middlesexmosquito.org

# ElectricSQL (private) — used by the shape auth-proxy
ELECTRIC_URL=http://electric.railway.internal:3000
ELECTRIC_SECRET=CHANGE_ME

# Public form intake.
#
# For local dev, use Cloudflare's published always-passes test pair instead of a real one:
#   secret  1x0000000000000000000000000000000AA   (here)
#   sitekey 1x00000000000000000000AA              (apps/public/.env)
# The widget then yields a dummy token that siteverify always accepts, so the intake path is
# exercisable without a real Turnstile account. Staging/production need the real pair.
CLOUDFLARE_TURNSTILE_SECRETKEY=CHANGE_ME

# Email (Resend) — password reset + employee invite
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=MCMEC <noreply@middlesexmosquito.org>
AUTH_RESET_URL=https://central.middlesexmosquito.org/reset-password

PORT=3000
