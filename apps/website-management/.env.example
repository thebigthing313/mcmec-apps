# Railway backend API origin (Better Auth + Electric shape proxy + data write path).
#
# Local dev goes through the repo-root Caddy proxy: browse the app at https://localhost:3447
# and it talks to the api at https://localhost:3443, which forwards to the local api on :3543.
#
# Both must be https. An http page calling an https API is cross-site under Chrome's
# schemeful same-site rules, so the session cookie is withheld and you bounce to /login.
# Run `caddy trust` once, then `caddy run` from the repo root.
VITE_API_URL=https://localhost:3443

# Brand images (logos, favicons, hero photographs), served by the api at /assets.
#
# Optional. Unset, they come from production — the bytes are identical everywhere, so one
# shared browser cache is the right default. Set this to your own api when a branch ADDS an
# image: it does not exist on production until that branch reaches `main`, so a new hero or
# logo 404s until then.
VITE_ASSETS_ORIGIN=https://localhost:3443
