# Railway backend API origin (Better Auth + Electric shape proxy + data write path).
#
# Local dev talks to the local api (see apps/api/.env), which proxies to staging.
VITE_API_URL=http://localhost:3005
# Optional: go through the repo-root Caddy HTTP/2 proxy so Electric shape long-polls aren't
# throttled by the browser's 6-connection HTTP/1.1 limit. Needs `caddy trust` + `caddy run`
# first; worth it once a page holds 6+ live shapes.
# VITE_API_URL=https://localhost:3443
