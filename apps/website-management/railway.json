{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "NIXPACKS",
		"buildCommand": "pnpm --filter website-management build",
		"watchPatterns": [
			"apps/website-management/**",
			"packages/**",
			"pnpm-lock.yaml"
		]
	},
	"deploy": {
		"startCommand": "pnpm --filter website-management start",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	}
}
